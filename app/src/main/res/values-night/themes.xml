<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Thème clair forcé : le design du jeu est conçu pour des couleurs chaudes et claires -->
    <style name="Base.Theme.Test_labyrinthe" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brown</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/sand</item>
        <item name="android:windowBackground">@drawable/bg_screen</item>
        <item name="android:statusBarColor">@color/bg_top</item>
        <item name="android:navigationBarColor">@color/bg_bottom</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.Test_labyrinthe" parent="Base.Theme.Test_labyrinthe" />

    <!-- Bouton principal (menus) -->
    <style name="Maze.Button" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">60dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.03</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/brown_dark</item>
        <item name="backgroundTint">@color/sand</item>
        <item name="cornerRadius">18dp</item>
        <item name="android:elevation">2dp</item>
    </style>

    <!-- Bouton secondaire (contour) -->
    <style name="Maze.Button.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/brown</item>
        <item name="strokeColor">@color/brown</item>
        <item name="strokeWidth">2dp</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <style name="Maze" />

    <style name="Maze.Title">
        <item name="android:textSize">34sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/brown_dark</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="Maze.StatLabel">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/brown_muted</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="Maze.StatValue">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/brown_dark</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
